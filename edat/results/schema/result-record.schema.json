{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adjad/Edge_device_agentic_testing/edat/results/schema/result-record.schema.json",
  "title": "tinyagent-bench result record (edat.result/1.0)",
  "description": "One graded unit: one entry (model x variant x thinking mode) on one case, one trial, in one run. One JSON object per line of a run's records.jsonl. Raw model output is never inside the record; `raw` points at a file stored beside it. See docs/benchmark/results-record.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "tier", "run_id", "board_version", "lang", "model", "runtime", "device",
               "settings", "harness_commit", "started_at", "case_id", "split", "trial", "status", "metrics",
               "safety", "raw"],
  "properties": {
    "schema": {"const": "edat.result/1.0"},
    "kind": {"enum": ["local", "cloud_reference"]},
    "tier": {"enum": ["agentic", "preferences", "long_session", "memory", "quality", "vision", "audio",
                      "perf", "in_assistant", "app_control", "sidekick", "phone_parity"]},
    "suite": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "board_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "lang": {"const": "en"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "role": {"enum": ["baseline", "reference", "candidate", "variant", "cloud_reference"]},
        "variant_of": {"type": ["string", "null"], "maxLength": 200},
        "headline_entry": {"type": ["boolean", "null"]},
        "weights_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "weights_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "weights_bytes": {"type": ["integer", "null"], "minimum": 0},
        "quant": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["scheme"],
          "properties": {
            "scheme": {"type": "string", "minLength": 1, "maxLength": 64},
            "bits": {"type": ["number", "null"], "minimum": 0},
            "group_size": {"type": ["integer", "null"], "minimum": 0},
            "mixed": {
              "description": "Mixed-bit quantisation: true/false, or 04's map of bit width to layer count, e.g. {\"5\": 84, \"6\": 18}. An empty map means not mixed.",
              "anyOf": [
                {"type": "boolean"},
                {"type": "null"},
                {"type": "object", "maxProperties": 16,
                 "propertyNames": {"pattern": "^[0-9]{1,2}$"},
                 "additionalProperties": {"type": "integer", "minimum": 0}}
              ]
            }
          }
        },
        "architecture": {"enum": ["dense", "moe", "dense_ple", "hybrid_ssm", "unknown", null]},
        "params_total": {"type": ["integer", "null"], "minimum": 0},
        "params_active": {"type": ["integer", "null"], "minimum": 0},
        "template_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "speculation": {"enum": ["none", "mtp", "draft_model", null]},
        "requested_model": {"type": ["string", "null"], "maxLength": 200},
        "resolved_model": {"type": ["string", "null"], "maxLength": 200},
        "upstream_provider": {"type": ["string", "null"], "maxLength": 200},
        "run_date": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["first", "last"],
          "properties": {
            "first": {"type": "string", "format": "date-time"},
            "last": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "version": {"type": ["string", "null"], "maxLength": 64},
        "backend": {"type": ["string", "null"], "maxLength": 64},
        "commit": {"type": ["string", "null"], "maxLength": 64}
      }
    },
    "device": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "class", "ram_bytes", "os"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "class": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "model_id": {"type": ["string", "null"], "maxLength": 64},
        "soc": {"type": ["string", "null"], "maxLength": 64},
        "ram_bytes": {"type": ["integer", "null"], "minimum": 0},
        "os": {"type": ["string", "null"], "maxLength": 64},
        "os_build": {"type": ["string", "null"], "maxLength": 64}
      }
    },
    "device_reason": {"enum": ["cloud"]},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thinking", "sampling", "sampling_source", "seed"],
      "properties": {
        "thinking": {"enum": ["on", "off", "minimal"]},
        "thinking_detail": {"type": ["string", "null"], "maxLength": 64},
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature": {"type": ["number", "null"], "minimum": 0},
            "top_p": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "top_k": {"type": ["integer", "null"], "minimum": 0},
            "min_p": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "repeat_penalty": {"type": ["number", "null"], "minimum": 0},
            "presence_penalty": {"type": ["number", "null"]},
            "frequency_penalty": {"type": ["number", "null"]},
            "max_output_tokens": {"type": ["integer", "null"], "minimum": 1},
            "reasoning_effort": {"type": ["string", "null"], "maxLength": 32}
          }
        },
        "sampling_source": {"enum": ["author_recommended", "fixed_sensitivity", "engine_default", "provider_default"]},
        "seed": {"anyOf": [{"type": "integer"}, {"const": "unsupported"}, {"type": "null"}]},
        "world_seed": {"type": ["integer", "null"]},
        "policy_fingerprint": {"type": ["string", "null"], "maxLength": 64}
      }
    },
    "harness_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "harness_dirty": {"type": "boolean"},
    "started_at": {"type": "string", "format": "date-time",
                   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,159}$"},
    "split": {"enum": ["dev", "heldout", "public_dataset"]},
    "trial": {"type": "integer", "minimum": 1, "maximum": 1000},
    "status": {"enum": ["ok", "excluded", "failed", "not_run", "does_not_fit", "out_of_memory",
                        "beyond_window", "not_applicable", "unsupported_by_runtime"]},
    "status_detail": {"type": ["string", "null"], "maxLength": 64},
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lane": {"enum": ["assistant", "neutral", null]},
        "family": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "category": {"type": ["string", "null"], "maxLength": 64},
        "surface": {"enum": ["ask", "brief", "day", null]},
        "profile": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "test": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "level_tokens": {"type": ["integer", "null"], "minimum": 0},
        "step": {"type": ["integer", "null"], "minimum": 0},
        "source_split": {"type": ["string", "null"], "maxLength": 32},
        "level": {"type": ["integer", "null"], "minimum": 0, "maximum": 99},
        "track": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "mode": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "band": {"enum": ["early", "middle", "late", null]},
        "dimension": {"enum": ["persistence", "override", "supersession", "scope", "no_waiver", null]},
        "arrival": {"enum": ["stored", "stated", null]},
        "zone": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "tags": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}}
      }
    },
    "metrics": {
      "type": "object",
      "maxProperties": 200,
      "propertyNames": {"pattern": "^[a-z][A-Za-z0-9_]{0,63}$"},
      "additionalProperties": {
        "anyOf": [
          {"type": "number"},
          {"type": "boolean"},
          {"type": "null"},
          {"type": "string", "maxLength": 64}
        ]
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unsafe_actions", "privacy_leaks"],
      "properties": {
        "unsafe_actions": {"type": ["integer", "null"], "minimum": 0},
        "privacy_leaks": {"type": ["integer", "null"], "minimum": 0},
        "labels": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}}
      }
    },
    "raw": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^raw/[0-9a-f]{64}\\.(json|txt)$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "raw_reason": {"type": "string", "maxLength": 64},
    "sample": {"type": "boolean"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "converter": {"type": "string", "maxLength": 64},
        "format": {"type": "string", "maxLength": 64},
        "row": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
