;; tinyagent-bench sidekick sandbox profile, version edat-sidekick-sb/2 (spec 12 §3.4, layer 3).
;;
;; Deny by default. Model-written code and commands may:
;;   * read the system (not /usr/local, no device but null, zero, random, urandom and their own
;;     descriptors, no terminal) and the pinned toolchains (listed by the harness at run time);
;;   * read and write only inside the trial's own throwaway folder;
;;   * execute only from /bin, /usr/bin, /usr/libexec and the pinned toolchains;
;;   * never use the network, loopback included.
;;
;; The harness renders this template: the TRIAL placeholder becomes the trial
;; folder and the two TOOLCHAIN placeholders become one subpath or literal
;; filter per toolchain path. Local paths are filled in at run
;; time and never committed. The sha256 of this template is part of the run key.

(version 1)
(deny default)

;; Processes: fork, signal own children, read basic system facts.
(allow process-fork)
(allow signal (target same-sandbox))
;; No information about any process outside this sandbox: not its arguments or environment
;; (KERN_PROCARGS2), its kinfo_proc, its path or its descriptors (proc_pidinfo, proc_pidpath), nor the
;; list of processes. The explicit deny is needed: the default alone leaves those reads open.
(deny process-info*)
(allow process-info* (target same-sandbox))

;; System facts (CPU count, OS version, page size, limits) that interpreters and libc read at start.
;; The process table is denied by name too; reads about other processes are denied above.
(allow sysctl-read)
(deny sysctl-read
  (sysctl-name-prefix "kern.proc")
  (sysctl-name "kern.procname"))

;; stat() anywhere (needed for path resolution); contents stay denied.
(allow file-read-metadata)

(allow process-exec
  (subpath "/bin")
  (subpath "/usr/bin")
  (subpath "/usr/libexec")
  (subpath "@TOOLS@")
  @TOOLCHAIN_EXEC@)

(allow file-read*
  (literal "/")
  (literal "/etc")
  (literal "/var")
  (literal "/tmp")
  (subpath "/bin")
  (subpath "/usr/bin")
  (subpath "/usr/sbin")
  (subpath "/usr/lib")
  (subpath "/usr/libexec")
  (subpath "/usr/share")
  (subpath "/System")
  (subpath "/Library/Preferences/Logging")
  (subpath "/private/etc")
  (subpath "/private/var/db/dyld")
  (subpath "/private/var/db/timezone")
  (literal "/dev")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (literal "/dev/dtracehelper")
  (subpath "/dev/fd")
  (subpath "@TRIAL@")
  (subpath "@TOOLS@")
  @TOOLCHAIN_READ@)

;; Inside the trial folder only, never the folder itself: sandboxed code cannot remove, replace or
;; (after the harness renames it) re-create the trial folder.
(allow file-write*
  (regex #"^@TRIAL_RE@/")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/dtracehelper")
  (subpath "/dev/fd"))

(allow file-ioctl
  (literal "/dev/null")
  (literal "/dev/dtracehelper"))

;; No terminal, ever: not the controlling one (/dev/tty), no pty or tty device (what a person types).
(deny file-read* file-write* file-ioctl
  (literal "/dev/tty")
  (regex #"^/dev/(tty|pty|ptmx|cu\.)"))

;; The few system services libc needs for user lookups and logging.
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.logd")
  (global-name "com.apple.system.logger"))
(allow ipc-posix-shm-read-data ipc-posix-shm-read-metadata
  (ipc-posix-name "apple.shm.notification_center"))

;; All network denied, loopback and Unix sockets included.
(deny network*)
