    ]
   },
   "family": "summary",
   "id": "summary_library",
   "max_tokens": 1024,
   "messages": [
    {
     "content": "Summarize the following in at most 40 words.\n\nThe Elmgrove branch library announced on Monday that it will close for renovation from 3 February until the end of June. The work, funded by a municipal grant of 1.2 million, will replace the roof, add a quiet study wing and widen the main entrance so wheelchairs and strollers can pass easily. During the closure, borrowers can return books at the Cedar Street branch, and a bookmobile will visit the Elmgrove market square every Saturday morning. Staff will move to Cedar Street, so opening hours there will extend by two hours on weekdays. Children's story time continues without interruption in the community hall on Fridays at 4 pm. The head librarian, Tomasz Varga, said residents had asked for more seating and quieter rooms for years and that the project answers both requests. Contractors expect noise only on weekdays, and the car park will stay open except for a fenced section near the delivery gate. A public viewing of the plans takes place at the town hall on 20 January. The library will reopen on 1 July with a free open day, and late fees accrued during the closure will be waived for every member.",
     "role": "user"
    }
   ],
   "source": "authored",
   "tool_set": null
  },
  {
   "expect": {
    "contains_all": [
