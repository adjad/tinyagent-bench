        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "when_iso": {
        "description": "local START datetime, e.g. 2026-07-14T15:00; for 6–7 PM use 18:00",
        "type": "string"
       }
      },
      "required": [
       "title",
       "when_iso"
      ],
      "type": "object"
     }
    },
    "type": "function"
   },
